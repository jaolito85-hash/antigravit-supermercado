# ==========================================================
# Node Data — Supermercado (Seu Pipico) — variáveis de ambiente
# Copie para .env e preencha. NUNCA comite o .env de verdade.
# ==========================================================

# Supabase (Projeto separado para supermercados)
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
# service_role: usada só no servidor para upload de banners (bypassa RLS).
# NUNCA exponha no frontend. Deixe em branco se não usar upload de banner.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# WhatsApp Cloud API (Meta) — API oficial
# Token de acesso do app. Em produção use um token PERMANENTE (System User).
WHATSAPP_TOKEN=seu_token_permanente_aqui
# Phone Number ID do número remetente (painel: WhatsApp > API Setup).
WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id_aqui
# Token que VOCÊ inventa — usado só na verificação (GET) do webhook no painel do Meta.
WHATSAPP_VERIFY_TOKEN=invente_uma_senha_aqui
# App Secret do app Meta (Configurações > Básico) — valida a assinatura X-Hub-Signature-256
# dos webhooks (POST). Gere/copie no painel; sem ele o webhook aceita qualquer origem.
WHATSAPP_APP_SECRET=seu_app_secret_aqui

# OpenAI
OPENAI_API_KEY=your_openai_key

# Identidade do Cliente (muda para cada supermercado)
MARKET_NAME=Atacaforte
AGENT_NAME=Seu Pipico

# ----------------------------------------------------------
# Auth do dashboard do gerente — OBRIGATÓRIO em produção
# Sem ADMIN_USER/ADMIN_PASS configurados, o login fica desabilitado (fail closed).
# Use uma senha forte e única (não reutilize senhas).
# ----------------------------------------------------------
ADMIN_USER=
ADMIN_PASS=
# SECRET_KEY: assina a sessão. Gere uma chave aleatória forte, ex:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Se ficar vazia, o servidor gera uma temporária (a sessão cai a cada restart).
SECRET_KEY=
# COOKIE_SECURE=true exige HTTPS (correto em produção/Coolify).
# Defina false APENAS para testar localmente sem HTTPS.
COOKIE_SECURE=true

# Server
PORT=5003
